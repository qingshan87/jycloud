<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jycloud.service.user.repository.mapper.RegionMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.jycloud.api.user.entity.Region">
        <id column="id" property="id" />
        <result column="code_id" property="codeId" />
        <result column="name" property="name" />
        <result column="fullname" property="fullname" />
        <result column="title" property="title" />
        <result column="pid" property="pid" />
        <result column="pid_path" property="pidPath" />
        <result column="code_pid" property="codePid" />
        <result column="level" property="level" />
        <result column="sort" property="sort" />
        <result column="status" property="status" />
        <result column="note" property="note" />
        <result column="lat" property="lat" />
        <result column="lon" property="lon" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, code_id, name, fullname, title, pid, pid_path, code_pid, level, sort, status, note, lat, lon
    </sql>

</mapper>
