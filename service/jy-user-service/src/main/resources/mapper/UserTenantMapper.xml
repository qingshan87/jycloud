<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jycloud.service.user.repository.mapper.UserTenantMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.jycloud.api.user.entity.UserTenant">
        <id column="id" property="id" />
        <result column="tenant_id" property="tenantId" />
        <result column="user_id" property="userId" />
        <result column="if_default" property="ifDefault" />
        <result column="consumer" property="consumer" />
        <result column="manager" property="manager" />
        <result column="status" property="status" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, tenant_id, user_id, if_default, consumer, manager, status
    </sql>

    <select id="selectUserTenantVOList" resultType="com.jycloud.api.user.vo.UserTenantVO">
        SELECT ut.id, ut.tenant_id, ut.user_id, ut.if_default, ut.consumer, ut.manager, ut.status,
               t.tenant_name AS tenantName, t.status AS tenantStatus
        FROM t_user_tenant ut
        LEFT JOIN t_tenant t ON ut.tenant_id = t.tenant_id AND t.status = 1
        WHERE ut.user_id = #{userId}
        ORDER BY ut.if_default DESC, ut.id DESC
    </select>

</mapper>
