<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jycloud.service.user.repository.mapper.RoleMenuMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.jycloud.api.user.entity.RoleMenu">
        <id column="id" property="id" />
        <result column="menu_id" property="menuId" />
        <result column="role_id" property="roleId" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, menu_id, role_id
    </sql>

    <!-- 查询绑定了指定菜单的角色所属的租户 ID 集合 -->
    <select id="listTenantIdsByMenuId" resultType="java.lang.String">
        SELECT DISTINCT r.tenant_id
        FROM t_role_menu rm
        INNER JOIN t_role r ON r.role_id = rm.role_id
        WHERE rm.menu_id = #{menuId}
          AND r.delete_flag = 0
    </select>

</mapper>
