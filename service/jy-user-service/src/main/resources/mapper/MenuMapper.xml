<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jycloud.service.user.repository.mapper.MenuMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.jycloud.api.user.entity.Menu">
        <id column="menu_id" property="menuId" />
        <result column="client_id" property="clientId" />
        <result column="parent_id" property="parentId" />
        <result column="menu_title" property="menuTitle" />
        <result column="menu_name" property="menuName" />
        <result column="path" property="path" />
        <result column="component" property="component" />
        <result column="perms" property="perms" />
        <result column="icon" property="icon" />
        <result column="category" property="category" />
        <result column="hide" property="hide" />
        <result column="sort" property="sort" />
        <result column="status" property="status" />
        <result column="create_uid" property="createUid" />
        <result column="create_time" property="createTime" />
        <result column="update_uid" property="updateUid" />
        <result column="update_time" property="updateTime" />
        <result column="delete_flag" property="deleteFlag" />
        <result column="delete_time" property="deleteTime" />
        <result column="delete_uid" property="deleteUid" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        menu_id, client_id, parent_id, menu_title, menu_name, path, component, perms, icon, category, hide, sort, status, create_uid, create_time, update_uid, update_time, delete_flag, delete_time, delete_uid
    </sql>

    <!-- 逻辑删除菜单 -->
    <update id="deleteById">
        UPDATE t_menu
        SET delete_flag = 1, delete_time = NOW(), delete_uid = #{deleteUid}
        WHERE menu_id = #{id} AND delete_flag = 0
    </update>

</mapper>
