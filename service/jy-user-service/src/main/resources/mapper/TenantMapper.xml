<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jycloud.service.user.repository.mapper.TenantMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.jycloud.api.user.entity.Tenant">
        <id column="id" property="id" />
        <result column="tenant_id" property="tenantId" />
        <result column="tenant_name" property="tenantName" />
        <result column="domain" property="domain" />
        <result column="linkman" property="linkman" />
        <result column="contact_tel" property="contactTel" />
        <result column="address" property="address" />
        <result column="status" property="status" />
        <result column="create_uid" property="createUid" />
        <result column="create_time" property="createTime" />
        <result column="update_uid" property="updateUid" />
        <result column="update_time" property="updateTime" />
        <result column="delete_flag" property="deleteFlag" />
        <result column="delete_time" property="deleteTime" />
        <result column="delete_uid" property="deleteUid" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, tenant_id, tenant_name, domain, linkman, contact_tel, address, status, create_uid, create_time, update_uid, update_time, delete_flag, delete_time, delete_uid
    </sql>

    <!-- 逻辑删除租户 -->
    <update id="deleteById">
        UPDATE t_tenant
        SET delete_flag = 1, delete_time = NOW(), delete_uid = #{deleteUid}
        WHERE id = #{id} AND delete_flag = 0
    </update>

</mapper>
